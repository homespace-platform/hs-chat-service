PORT=8082
SERVICE_NAME=hs-chat-service
MONGODB_URI=mongodb://<username>:<password>@<host>:<port>/<database>?authSource=<auth-database>
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka
# localhost/127.0.0.1 = auto-detect the physical IPv4 address (like prefer-ip-address=true)
EUREKA_INSTANCE_HOSTNAME=localhost
